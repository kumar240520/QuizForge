[Unit]
Description=QuizForge FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/QuizForge
Environment="PATH=/home/ubuntu/QuizForge/backend/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/home/ubuntu/QuizForge/.env
ExecStart=/home/ubuntu/QuizForge/backend/venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
