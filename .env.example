# QuizForge Environment Variables Template (.env.example)
# Copy this to .env and customize as needed.

APP_NAME=QuizForge
DATABASE_URL=sqlite:///./quizforge.db
MAX_UPLOAD_SIZE_MB=25

# Cryptographic & Session Secrets (Replace with random strings in production)
SECRET_KEY=change-this-to-a-secure-random-secret
JWT_SECRET_KEY=change-this-to-a-jwt-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Private Admin / Owner 2FA Gatekeeper Key (Google Authenticator Base32 Setup Key)
# Users will need this 6-digit TOTP code during registration
MASTER_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Default Gemini AI Configuration (Optional: Users can supply their own keys in the app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
